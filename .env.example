# The sidecar binds to loopback by default.
CYBERFORGE_BIND=127.0.0.1
CYBERFORGE_PORT=8788
CYBERFORGE_DATA_DIR=$HOME/.local/share/cyberforge
CYBERFORGE_DEFAULT_WORLDS=12000
CYBERFORGE_MAX_WORLDS=250000
CYBERFORGE_REQUIRE_AUTHORIZATION=true
CYBERFORGE_ALLOW_ENV_KEY_IMPORT=false

# Encrypted SQLite is the authoritative store. The database contains encrypted
# payloads and keyed blind-search tokens, never plaintext report bodies.
CYBERFORGE_STORAGE_DB=cyberforge.sqlite3
CYBERFORGE_AUTO_PERSIST_RESEARCH=true

# Memory routing: auto, remote, embedded, or off.
# auto tries remote Weaviate, then embedded Weaviate, then SQLite-only retrieval.
CYBERFORGE_WEAVIATE_MODE=auto
CYBERFORGE_WEAVIATE_HTTP_HOST=127.0.0.1
CYBERFORGE_WEAVIATE_HTTP_PORT=8080
CYBERFORGE_WEAVIATE_GRPC_HOST=127.0.0.1
CYBERFORGE_WEAVIATE_GRPC_PORT=50051
CYBERFORGE_WEAVIATE_SECURE=false
CYBERFORGE_WEAVIATE_COLLECTION=CyberForgeMemoryV1
CYBERFORGE_WEAVIATE_EMBEDDED_VERSION=1.37.0
CYBERFORGE_WEAVIATE_EMBEDDED_HTTP_PORT=8079
CYBERFORGE_WEAVIATE_EMBEDDED_GRPC_PORT=50050
CYBERFORGE_WEAVIATE_HYBRID_ALPHA=0.55
CYBERFORGE_MEMORY_RRF_K=60
CYBERFORGE_MEMORY_MMR_LAMBDA=0.72
# CYBERFORGE_WEAVIATE_API_KEY=

# Recommended: enter provider keys through the encrypted CyberForge vault UI.
# These variables are read only when environment import is explicitly enabled.
# OPENAI_API_KEY=
# XAI_API_KEY=
# DIGITALOCEAN_TOKEN=
# GEMINI_API_KEY=
