# The sidecar binds to loopback by default.
CYBERFORGE_BIND=127.0.0.1
CYBERFORGE_PORT=8788
CYBERFORGE_DATA_DIR=$HOME/.local/share/cyberforge
CYBERFORGE_DEFAULT_WORLDS=12000
CYBERFORGE_MAX_WORLDS=250000
CYBERFORGE_REQUIRE_AUTHORIZATION=true
CYBERFORGE_ALLOW_ENV_KEY_IMPORT=false

# Recommended: enter provider keys through the encrypted CyberForge vault UI.
# These variables are read only when environment import is explicitly enabled.
# OPENAI_API_KEY=
# XAI_API_KEY=
# DIGITALOCEAN_TOKEN=
# GEMINI_API_KEY=
